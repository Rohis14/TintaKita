# ===================================================
# KONFIGURASI SERVER
# ===================================================
PORT=5000
NODE_ENV=development

# ===================================================
# DATABASE POSTGRESQL (AIVEN)
# ===================================================
# Opsi 1: Menggunakan Service URI langsung dari Dashboard Aiven (Direkomendasikan)
DATABASE_URL=postgres://avnadmin:YOUR_PASSWORD@YOUR_AIVEN_HOST:YOUR_AIVEN_PORT/defaultdb?sslmode=require

# Opsi 2: Parameter Terpisah (Jika diperlukan secara modular)
PGHOST=YOUR_AIVEN_HOST
PGPORT=YOUR_AIVEN_PORT
PGUSER=avnadmin
PGPASSWORD=YOUR_PASSWORD
PGDATABASE=defaultdb
PGSSL=true

# ===================================================
# JSON WEB TOKEN (JWT) AUTHENTICATION
# ===================================================
JWT_SECRET=rahasia_super_secret_key_tintakita_ganti_di_produksi
JWT_EXPIRES_IN=1d

# ===================================================
# CLOUDINARY CONFIGURATION (STORAGE GAMBAR)
# ===================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

